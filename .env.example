# ═══════════════════════════════════════════════════════════════════════════════
# Pseudonymization Tool — Configurazione ambiente
# ═══════════════════════════════════════════════════════════════════════════════
#
# SETUP:
#   cp .env.example .env
#   Modifica .env con valori sicuri prima di avviare i container.
#   Il file .env NON deve essere committato nel repository (già in .gitignore).
#
# GENERARE PASSWORD SICURE:
#   openssl rand -base64 32
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Autenticazione applicazione ────────────────────────────────────────────
# Username per il login all'interfaccia web
AUTH_USERNAME=admin

# Password per il login all'interfaccia web.
# OBBLIGATORIA: il container non si avvia senza questo valore.
# Minimo 12 caratteri, entropia elevata.
# Esempio: openssl rand -base64 24
AUTH_PASSWORD=CAMBIA_QUESTA_PASSWORD

# ─── Redis ──────────────────────────────────────────────────────────────────
# Password per il server Redis (autenticazione requirepass).
# OBBLIGATORIA: usata da tutti i servizi che si connettono a Redis.
# Esempio: openssl rand -base64 32
REDIS_PASSWORD=CAMBIA_QUESTA_PASSWORD_REDIS

# ─── Flower (dashboard Celery, profilo "monitoring") ────────────────────────
# Credenziali per l'accesso alla dashboard Flower su http://localhost:5555
# Attiva solo con: docker compose --profile monitoring up -d
FLOWER_USER=flower
FLOWER_PASSWORD=CAMBIA_QUESTA_PASSWORD_FLOWER
