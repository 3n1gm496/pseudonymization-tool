# ═══════════════════════════════════════════════════════════════════════════════
# Pseudonymization Tool — Configurazione ambiente
# ═══════════════════════════════════════════════════════════════════════════════
#
# SETUP:
#   cp .env.example .env
#   Modifica .env con valori sicuri prima di avviare i container.
#   Il file .env NON deve essere committato nel repository (già in .gitignore).
#
# GENERARE PASSWORD SICURE:
#   openssl rand -base64 32
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Profilo di deployment ───────────────────────────────────────────────────
# Valori validi: dev | staging | prod
# - dev:     CORS permissivo, auth opzionale, Swagger UI attivo, log DEBUG
# - staging: CORS ristretto, auth obbligatoria, Swagger UI attivo, log INFO
# - prod:    CORS ristretto, auth obbligatoria, Swagger UI disattivo, log WARNING
# OBBLIGATORIO in produzione: il container non si avvia senza questo valore
# quando DEPLOYMENT_PROFILE=prod o staging.
DEPLOYMENT_PROFILE=prod

# ─── Autenticazione applicazione ────────────────────────────────────────────
# Username per il login all'interfaccia web
AUTH_USERNAME=admin

# Password per il login all'interfaccia web.
# OBBLIGATORIA: il container non si avvia senza questo valore.
# Minimo 12 caratteri, entropia elevata.
# Esempio: openssl rand -base64 24
AUTH_PASSWORD=CAMBIA_QUESTA_PASSWORD

# Chiave segreta per la firma dei token di sessione (HMAC-SHA256).
# OBBLIGATORIA in PROD/STAGING: il container non si avvia senza questo valore.
# Minimo 32 caratteri. Generare con: openssl rand -base64 48
# IMPORTANTE: non condividere mai questo valore; cambiarlo invalida tutte le sessioni attive.
AUTH_SECRET=CAMBIA_QUESTO_SECRET

# ─── CORS — URL del frontend ─────────────────────────────────────────────────
# URL pubblico del frontend (usato come allowed origin per CORS in PROD).
# OBBLIGATORIO in PROD: il container non si avvia senza questo valore.
# Esempio: https://pseudonymizer.example.com
PROD_FRONTEND_URL=https://CAMBIA_QUESTO_DOMINIO

# ─── Redis ──────────────────────────────────────────────────────────────────
# Password per il server Redis (autenticazione requirepass).
# OBBLIGATORIA: usata da tutti i servizi che si connettono a Redis.
# Esempio: openssl rand -base64 32
REDIS_PASSWORD=CAMBIA_QUESTA_PASSWORD_REDIS

# ─── Performance ─────────────────────────────────────────────────────────────
# Numero di worker uvicorn (processi paralleli).
# Default: 1 (sicuro con il rate limiter in-memory).
# Aumentare a 4 solo dopo aver abilitato il rate limiter Redis-backed.
# Regola pratica: (2 × CPU) + 1
WEB_CONCURRENCY=1

# ─── Flower (dashboard Celery, profilo "monitoring") ────────────────────────
# Credenziali per l'accesso alla dashboard Flower su http://localhost:5555
# Attiva solo con: docker compose --profile monitoring up -d
FLOWER_USER=flower
FLOWER_PASSWORD=CAMBIA_QUESTA_PASSWORD_FLOWER
